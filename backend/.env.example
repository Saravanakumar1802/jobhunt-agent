# ---- Database (MongoDB Atlas free M0). Leave empty to use the in-memory DB (data resets on restart).
MONGODB_URI=
MONGODB_DB=job_copilot

# ---- Auth: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- Free LLM providers (no credit card on any of them) — see docs/SETUP_KEYS.md
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- Job sources
RAPIDAPI_KEY=          # JSearch (LinkedIn / Naukri via Google for Jobs) — Basic free plan
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Optional tuning
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JSEARCH_MONTHLY_QUOTA=200
ADZUNA_MONTHLY_QUOTA=2500
SEARCH_CACHE_TTL_HOURS=6
PREFILTER_TOP_K=12
